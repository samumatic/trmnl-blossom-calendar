{% if bc_ok %}
<div class="layout layout--row layout--top gap--medium">
  <div class="flex flex--col flex--center-x gap--xsmall flex-none">
    {{ bc_bloom | replace: "bc-daysize", bc_ds_small }}
    <span class="label lg:label--large bc-script">{{ bc_weekday }}</span>
  </div>
  <div class="grow w--full bc-main">{{ bc_agenda | replace: "bc-cols", "2" }}</div>
</div>
{% else %}
{{ bc_empty }}
{% endif %}
{{ bc_title_bar }}
