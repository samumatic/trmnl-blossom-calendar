      <path d="M-11 16V-2C-11 -10 -6 -15 0 -15C6 -15 11 -10 11 -2V16L7.3 12.5L3.7 16L0 12.5L-3.7 16L-7.3 12.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <g fill="currentColor"><ellipse cx="-4" cy="-4" rx="1.8" ry="2.6"/><ellipse cx="4" cy="-4" rx="1.8" ry="2.6"/><ellipse cy="3" rx="1.6" ry="2"/></g>
    </symbol>
    <symbol id="bc-tulip" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
        <path d="M-8 -13L-4 -8.5L0 -15L4 -8.5L8 -13C8.5 -3 5 1.5 0 1.5C-5 1.5 -8.5 -3 -8 -13Z"/><path d="M0 1.5V17"/>
      </g>
      <path d="M0 14Q-9 12 -11 4Q-3 5.5 0 14Z" fill="currentColor"/>
    </symbol>
    <symbol id="bc-cake" viewBox="-20 -20 40 40">
      <path d="M0 -18Q3.5 -13.5 0 -10.5Q-3.5 -13.5 0 -18Z" fill="currentColor"/>
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
        <path d="M0 -10.5V-6"/><rect x="-9" y="-6" width="18" height="8" rx="1.5"/><rect x="-14" y="2" width="28" height="13" rx="2"/>
        <path d="M-14 6Q-10.5 9 -7 6T0 6T7 6T14 6"/>
      </g>
    </symbol>
    <symbol id="bc-balloon" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <ellipse cy="-6" rx="9.5" ry="11.5"/><path d="M0 7.5Q-4 11 0 14T0 19"/><path d="M-4.5 -12A6 6 0 0 1 -1 -15" stroke-width="1.6"/>
      </g>
      <path d="M0 5.5L-2.5 8H2.5Z" fill="currentColor"/>
    </symbol>
    <symbol id="bc-heart" viewBox="0 0 24 22">
      <path d="M12 21C5 15.5 1 11.6 1 7a5.6 5.6 0 0 1 11-1.6A5.6 5.6 0 0 1 23 7c0 4.6-4 8.5-11 14z" fill="currentColor"/>
    </symbol>
    <symbol id="bc-heart-o" viewBox="0 0 24 22">
      <path d="M12 19.6C5.6 14.6 2.2 11.1 2.2 7a4.5 4.5 0 0 1 8.9-1.3h1.8A4.5 4.5 0 0 1 21.8 7c0 4.1-3.4 7.6-9.8 12.6z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
