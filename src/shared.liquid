{% comment %}
  Blossom Calendar reads TRMNL's own calendar plugins (Google, Outlook, Apple, CalDAV) through Plugin Merge:
  TRMNL fetches and expands the calendar, this markup only lays it out. Plugin Merge runs no serverless
  transform, so everything below is Liquid.
{% endcomment %}
{% assign bc_fields = trmnl.plugin_settings.custom_fields_values %}

{% comment %}
  The chosen calendar plugins. A plugin_instance_select field's own name holds the plugin's data (as Pretty
  Calendar reads it); where it holds the data's name instead ("caldav_123", as the Plugin Data API names it), that
  name is looked up. Field names spelled out: TRMNL's publish check looks for each field in the markup.
{% endcomment %}
{% assign bc_events = "" | split: "" %}
{% assign bc_has_source = false %}{% assign bc_has_data = false %}
{% assign bc_first_day = nil %}{% assign bc_src_clock = "" %}
{% assign bc_source_fields = "calendar_1,calendar_2,calendar_3" | split: "," %}
{% for bc_f in bc_source_fields %}
  {% assign bc_key = bc_fields[bc_f] | default: "" | strip %}
  {% if bc_key == "" %}{% continue %}{% endif %}
  {% assign bc_has_source = true %}
  {% assign bc_src = [bc_f] %}
  {% if bc_src.events == nil %}{% assign bc_src = [bc_key] %}{% endif %}
  {% if bc_src.events == nil and bc_src.merge_variables %}{% assign bc_src = bc_src.merge_variables %}{% endif %}
  {% if bc_src.events %}
    {% assign bc_has_data = true %}
    {% assign bc_events = bc_events | concat: bc_src.events %}
    {% if bc_first_day == nil and bc_src.first_day != nil %}{% assign bc_first_day = bc_src.first_day | plus: 0 %}{% endif %}
    {% if bc_src_clock == "" and bc_src.time_format %}{% assign bc_src_clock = bc_src.time_format | downcase %}{% endif %}
  {% endif %}
{% endfor %}
{% if bc_first_day == nil %}{% assign bc_first_day = 1 %}{% endif %}

{% assign bc_lang = bc_fields.language | default: "auto" | downcase %}
{% if bc_lang != "de" and bc_lang != "en" %}
  {% assign bc_locale = trmnl.user.locale | default: "en" | slice: 0, 2 | downcase %}
  {% if bc_locale == "de" %}{% assign bc_lang = "de" %}{% else %}{% assign bc_lang = "en" %}{% endif %}
{% endif %}
{% comment %} 12-hour clock: chosen here, else as the calendar plugin shows it ("am/pm"), else by language. {% endcomment %}
{% assign bc_clock = bc_fields.time_format | default: "auto" | downcase %}
{% if bc_clock == "12" %}{% assign bc_12 = true %}
{% elsif bc_clock == "24" %}{% assign bc_12 = false %}
{% elsif bc_src_clock contains "am" %}{% assign bc_12 = true %}
{% elsif bc_src_clock != "" %}{% assign bc_12 = false %}
{% elsif bc_lang == "en" %}{% assign bc_12 = true %}{% else %}{% assign bc_12 = false %}{% endif %}

{% comment %} Words. Weekdays Monday first. {% endcomment %}
{% if bc_lang == "de" %}
  {% assign bc_wd_long = "Montag,Dienstag,Mittwoch,Donnerstag,Freitag,Samstag,Sonntag" | split: "," %}
  {% assign bc_wd = "Mo,Di,Mi,Do,Fr,Sa,So" | split: "," %}
  {% assign bc_wd_one = "M,D,M,D,F,S,S" | split: "," %}
  {% assign bc_mon_long = "Januar,Februar,März,April,Mai,Juni,Juli,August,September,Oktober,November,Dezember" | split: "," %}
  {% assign bc_mon = "Jan.,Feb.,März,Apr.,Mai,Juni,Juli,Aug.,Sep.,Okt.,Nov.,Dez." | split: "," %}
  {% assign bc_w_today = "Heute" %}{% assign bc_w_tomorrow = "Morgen" %}{% assign bc_w_all_day = "ganztags" %}
  {% assign bc_w_from = "ab" %}{% assign bc_w_until = "bis" %}{% assign bc_w_day = "Tag" %}{% assign bc_w_of = "von" %}
  {% assign bc_w_free = "Heute ist nichts mehr geplant" %}{% assign bc_w_free2 = "Genieß den Tag!" %}
  {% assign bc_w_nothing = "Keine Termine in Sicht" %}
  {% assign bc_w_title = "Mein Kalender" %}{% assign bc_w_demo = "Beispieltermine" %}{% assign bc_w_bday = "Alles Liebe zum Geburtstag!" %}
  {% assign bc_w_error = "Noch keine Termine vom Kalender-Plugin" %}
  {% assign bc_w_error2 = "Lass das Kalender-Plugin in einer Playlist (ausgeblendet reicht) und aktualisiere es einmal." %}
  {% assign bc_demo = "Yoga mit Mia,Brunch bei Oma,Maniküre,Mädelsabend,Geburtstag von Lena,Kino: Liebeskomödie,Wochenmarkt,Picknick im Park,Tanzkurs" | split: "," %}
{% else %}
  {% assign bc_wd_long = "Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday" | split: "," %}
  {% assign bc_wd = "Mon,Tue,Wed,Thu,Fri,Sat,Sun" | split: "," %}
  {% assign bc_wd_one = "M,T,W,T,F,S,S" | split: "," %}
  {% assign bc_mon_long = "January,February,March,April,May,June,July,August,September,October,November,December" | split: "," %}
  {% assign bc_mon = "Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec" | split: "," %}
  {% assign bc_w_today = "Today" %}{% assign bc_w_tomorrow = "Tomorrow" %}{% assign bc_w_all_day = "all day" %}
  {% assign bc_w_from = "from" %}{% assign bc_w_until = "until" %}{% assign bc_w_day = "Day" %}{% assign bc_w_of = "of" %}
  {% assign bc_w_free = "Nothing else planned today" %}{% assign bc_w_free2 = "Enjoy your day!" %}
  {% assign bc_w_nothing = "No events coming up" %}
  {% assign bc_w_title = "My Calendar" %}{% assign bc_w_demo = "Example events" %}{% assign bc_w_bday = "Happy birthday!" %}
  {% assign bc_w_error = "No events from the calendar plugin yet" %}
  {% assign bc_w_error2 = "Keep the calendar plugin in a playlist (hidden is fine) and refresh it once." %}
  {% assign bc_demo = "Yoga with Mia,Brunch at Grandma's,Manicure,Girls' night,Lena's birthday,Cinema: rom-com,Farmers market,Picnic in the park,Dance class" | split: "," %}
{% endif %}

{% comment %} Now, in the account's time zone. Dates are shifted to noon UTC before day arithmetic, so the server's zone can't move them. {% endcomment %}
{% assign bc_now = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset %}
{% assign bc_today_iso = bc_now | date: "%Y-%m-%d" %}
{% assign bc_now_str = bc_now | date: "%Y-%m-%dT%H:%M" %}
{% assign bc_today_ts = bc_today_iso | append: "T12:00:00Z" | date: "%s" | plus: 0 %}
{% assign bc_today_wd = bc_now | date: "%u" | minus: 1 %}
{% assign bc_today_day = bc_now | date: "%-d" | plus: 0 %}
{% assign bc_mi = bc_now | date: "%-m" | minus: 1 %}
{% assign bc_weekday = bc_wd_long[bc_today_wd] %}
{% capture bc_month_year %}{{ bc_mon_long[bc_mi] }} {{ bc_now | date: "%Y" }}{% endcapture %}
{% assign bc_days_ahead = bc_fields.days_ahead | default: 7 | plus: 0 %}
{% if bc_days_ahead < 1 or bc_days_ahead > 14 %}{% assign bc_days_ahead = 7 %}{% endif %}

{% comment %}
  Motif: spring daisies, summer sunflowers and cherries, autumn maple leaves and acorns, winter snowflakes and holly.
  Automatic follows the month (spring March to May, and so on), turned half a year in time zones south of the equator.
{% endcomment %}
{% assign bc_season = bc_fields.motif | default: "auto" | downcase %}
{% if bc_season != "spring" and bc_season != "summer" and bc_season != "autumn" and bc_season != "winter" %}
  {% assign bc_m = bc_now | date: "%-m" | plus: 0 %}
  {% assign bc_tzn = trmnl.user.time_zone_iana | default: "" %}
  {% assign bc_south = false %}
  {% assign bc_south_zones = "Australia/,Pacific/Auckland,Pacific/Chatham,Pacific/Fiji,America/Sao_Paulo,America/Argentina,America/Buenos_Aires,America/Santiago,America/Montevideo,America/Asuncion,America/La_Paz,America/Lima,Africa/Johannesburg,Africa/Maputo,Africa/Windhoek,Africa/Harare,Indian/Mauritius,Indian/Reunion,Antarctica/" | split: "," %}
  {% for bc_z in bc_south_zones %}{% if bc_tzn contains bc_z %}{% assign bc_south = true %}{% endif %}{% endfor %}
  {% if bc_south %}{% assign bc_m = bc_m | plus: 5 | modulo: 12 | plus: 1 %}{% endif %}
  {% case bc_m %}
    {% when 3, 4, 5 %}{% assign bc_season = "spring" %}
    {% when 6, 7, 8 %}{% assign bc_season = "summer" %}
    {% when 9, 10, 11 %}{% assign bc_season = "autumn" %}
    {% else %}{% assign bc_season = "winter" %}
  {% endcase %}
{% endif %}
{% comment %}
  Holiday decoration (on unless switched off), over any motif, for days most users of TRMNL (mostly US and Europe) keep:
  Advent and Christmas 1 to 26 December (stars, candles; no snow, so it suits the southern summer too), New Year's Eve
  and Day (fireworks, four-leaf clover), Valentine's 12 to 14 February (hearts, love letters), Halloween 25 to 31 October
  (pumpkins, ghosts), Mother's Day (tulips, hearts) and Easter from the Monday before to Easter Monday (eggs, bunnies).
  Western Easter Sunday by the anonymous Gregorian algorithm (Meeus/Jones/Butcher).
{% endcomment %}
{% assign bc_holidays = bc_fields.holidays | default: "true" | append: "" | downcase %}
{% if bc_holidays != "false" %}
  {% assign bc_mm = bc_now | date: "%-m" | plus: 0 %}{% assign bc_dd = bc_now | date: "%-d" | plus: 0 %}
  {% if bc_mm == 12 and bc_dd <= 26 %}{% assign bc_season = "christmas" %}{% endif %}
  {% comment %} Liquid reads and/or right to left without precedence: one condition per tag. {% endcomment %}
  {% if bc_mm == 12 and bc_dd == 31 %}{% assign bc_season = "newyear" %}{% endif %}
  {% if bc_mm == 1 and bc_dd == 1 %}{% assign bc_season = "newyear" %}{% endif %}
  {% if bc_mm == 2 and bc_dd >= 12 and bc_dd <= 14 %}{% assign bc_season = "valentine" %}{% endif %}
  {% if bc_mm == 10 and bc_dd >= 25 %}{% assign bc_season = "halloween" %}{% endif %}
  {% comment %} Mother's Day: second Sunday in May, as in the US and Germany. {% endcomment %}
  {% if bc_mm == 5 %}
    {% assign bc_may1 = bc_now | date: "%Y" | append: "-05-01T12:00:00Z" | date: "%w" | plus: 0 %}
    {% assign bc_mother = 7 | minus: bc_may1 | modulo: 7 | plus: 8 %}
    {% if bc_dd == bc_mother %}{% assign bc_season = "mother" %}{% endif %}
  {% endif %}
  {% assign bc_y = bc_now | date: "%Y" | plus: 0 %}
  {% assign bc_ea = bc_y | modulo: 19 %}{% assign bc_eb = bc_y | divided_by: 100 %}{% assign bc_ec = bc_y | modulo: 100 %}
  {% assign bc_ed = bc_eb | divided_by: 4 %}{% assign bc_ee = bc_eb | modulo: 4 %}
  {% assign bc_ef = bc_eb | plus: 8 | divided_by: 25 %}{% assign bc_eg = bc_eb | minus: bc_ef | plus: 1 | divided_by: 3 %}
  {% assign bc_eh = bc_ea | times: 19 | plus: bc_eb | minus: bc_ed | minus: bc_eg | plus: 15 | modulo: 30 %}
  {% assign bc_ei = bc_ec | divided_by: 4 %}{% assign bc_ek = bc_ec | modulo: 4 %}
  {% assign bc_el = bc_ee | times: 2 | plus: 32 | plus: bc_ei | plus: bc_ei | minus: bc_eh | minus: bc_ek | modulo: 7 %}
  {% assign bc_l22 = bc_el | times: 22 %}{% assign bc_em = bc_eh | times: 11 | plus: bc_ea | plus: bc_l22 | divided_by: 451 %}
  {% assign bc_m7 = bc_em | times: 7 %}{% assign bc_en = bc_eh | plus: bc_el | minus: bc_m7 | plus: 114 %}
  {% assign bc_emonth = bc_en | divided_by: 31 %}{% assign bc_eday = bc_en | modulo: 31 | plus: 1 %}
  {% capture bc_easter %}{{ bc_y }}-{% if bc_emonth < 10 %}0{% endif %}{{ bc_emonth }}-{% if bc_eday < 10 %}0{% endif %}{{ bc_eday }}T12:00:00Z{% endcapture %}
  {% assign bc_easter_days = bc_easter | date: "%s" | plus: 0 | minus: bc_today_ts | divided_by: 86400 %}
  {% if bc_easter_days <= 6 and bc_easter_days >= -1 %}{% assign bc_season = "easter" %}{% endif %}
{% endif %}
{% comment %} Own birthday (optional date field, any year), over everything else; 29 February shows on the 28th in other years. {% endcomment %}
{% assign bc_bday = bc_fields.birthday | default: "" | strip | slice: 5, 5 %}
{% assign bc_today_md = bc_now | date: "%m-%d" %}
{% assign bc_birthday = false %}
{% if bc_bday != "" %}
  {% if bc_bday == bc_today_md %}{% assign bc_birthday = true %}{% endif %}
  {% assign bc_next_md = bc_today_ts | plus: 86400 | date: "%m-%d" %}
  {% if bc_bday == "02-29" and bc_today_md == "02-28" and bc_next_md == "03-01" %}{% assign bc_birthday = true %}{% endif %}
{% endif %}
{% if bc_birthday %}{% assign bc_season = "birthday" %}{% endif %}
{% case bc_season %}
  {% when "birthday" %}{% assign bc_sym_a = "#bc-cake" %}{% assign bc_sym_b = "#bc-balloon" %}
  {% when "newyear" %}{% assign bc_sym_a = "#bc-firework" %}{% assign bc_sym_b = "#bc-clover" %}
  {% when "valentine" %}{% assign bc_sym_a = "#bc-heart-big" %}{% assign bc_sym_b = "#bc-envelope" %}
  {% when "halloween" %}{% assign bc_sym_a = "#bc-pumpkin" %}{% assign bc_sym_b = "#bc-ghost" %}
  {% when "mother" %}{% assign bc_sym_a = "#bc-tulip" %}{% assign bc_sym_b = "#bc-heart-big" %}
  {% when "christmas" %}{% assign bc_sym_a = "#bc-star" %}{% assign bc_sym_b = "#bc-candle" %}
  {% when "easter" %}{% assign bc_sym_a = "#bc-egg" %}{% assign bc_sym_b = "#bc-bunny" %}
  {% when "summer" %}{% assign bc_sym_a = "#bc-sunflower" %}{% assign bc_sym_b = "#bc-cherries" %}
  {% when "autumn" %}{% assign bc_sym_a = "#bc-maple" %}{% assign bc_sym_b = "#bc-acorn" %}
  {% when "winter" %}{% assign bc_sym_a = "#bc-snowflake" %}{% assign bc_sym_b = "#bc-holly" %}
  {% else %}{% assign bc_sym_a = "#bc-daisy" %}{% assign bc_sym_b = "#bc-daisy" %}
{% endcase %}

{% comment %}
  Every event as one row "key¦first day¦last day¦start¦end¦end day¦title", sorted so all-day events (key A) come
  first and the rest by start time (key T + HH:MM). Times come straight from the plugin's ISO strings, which are
  already in the calendar's local time. An all-day event's end date is exclusive; so is a midnight end. The CalDAV
  plugin flags timed events over several days as all-day but keeps their times: all-day means midnight to midnight.
{% endcomment %}
{% assign bc_rows = "" %}
{% if bc_has_source %}
  {% for bc_e in bc_events %}
    {% assign bc_st = bc_e.status | default: "" | downcase %}
    {% if bc_st == "cancelled" %}{% continue %}{% endif %}
    {% assign bc_s = bc_e.start_full | default: bc_e.date_time | default: "" | append: "" %}
    {% if bc_s.size < 10 %}{% continue %}{% endif %}
    {% assign bc_en = bc_e.end_full | default: bc_s | append: "" %}
    {% assign bc_sd = bc_s | slice: 0, 10 %}{% assign bc_ed = bc_en | slice: 0, 10 %}
    {% if bc_s.size > 10 %}{% assign bc_shm = bc_s | slice: 11, 5 %}{% else %}{% assign bc_shm = "00:00" %}{% endif %}
    {% if bc_en.size > 10 %}{% assign bc_ehm = bc_en | slice: 11, 5 %}{% else %}{% assign bc_ehm = "00:00" %}{% endif %}
    {% assign bc_allday = false %}
    {% if bc_s.size == 10 %}{% assign bc_allday = true %}
    {% elsif bc_e.all_day and bc_shm == "00:00" and bc_ehm == "00:00" %}{% assign bc_allday = true %}{% endif %}
    {% assign bc_last = bc_ed %}
    {% if bc_ed > bc_sd and bc_ehm == "00:00" %}{% assign bc_last = bc_ed | append: "T12:00:00Z" | date: "%s" | minus: 86400 | date: "%Y-%m-%d" %}{% endif %}
    {% if bc_last < bc_sd %}{% assign bc_last = bc_sd %}{% endif %}
    {% assign bc_title = bc_e.summary | default: "–" | replace: "¦", " " | replace: "§", " " | strip_newlines | strip %}
    {% capture bc_rows %}{{ bc_rows }}§{% if bc_allday %}A{% else %}T{{ bc_shm }}{% endif %}¦{{ bc_sd }}¦{{ bc_last }}¦{{ bc_shm }}¦{{ bc_ehm }}¦{{ bc_ed }}¦{{ bc_title }}{% endcapture %}
  {% endfor %}
{% else %}
  {% comment %} No calendar chosen: made-up events around today, so the recipe shows what it does (and no one's real data). {% endcomment %}
  {% assign bc_d0 = bc_today_iso %}
  {% assign bc_d1 = bc_today_ts | plus: 86400 | date: "%Y-%m-%d" %}{% assign bc_d2 = bc_today_ts | plus: 172800 | date: "%Y-%m-%d" %}
  {% assign bc_d3 = bc_today_ts | plus: 259200 | date: "%Y-%m-%d" %}{% assign bc_d4 = bc_today_ts | plus: 345600 | date: "%Y-%m-%d" %}
  {% assign bc_d5 = bc_today_ts | plus: 432000 | date: "%Y-%m-%d" %}{% assign bc_d6 = bc_today_ts | plus: 518400 | date: "%Y-%m-%d" %}
  {% capture bc_rows %}§T08:00¦{{ bc_d0 }}¦{{ bc_d0 }}¦08:00¦09:00¦{{ bc_d0 }}¦{{ bc_demo[0] }}§T11:30¦{{ bc_d0 }}¦{{ bc_d0 }}¦11:30¦13:00¦{{ bc_d0 }}¦{{ bc_demo[1] }}§T19:00¦{{ bc_d0 }}¦{{ bc_d0 }}¦19:00¦20:00¦{{ bc_d0 }}¦{{ bc_demo[2] }}§T20:00¦{{ bc_d1 }}¦{{ bc_d1 }}¦20:00¦23:00¦{{ bc_d1 }}¦{{ bc_demo[3] }}§A¦{{ bc_d2 }}¦{{ bc_d2 }}¦00:00¦00:00¦{{ bc_d3 }}¦{{ bc_demo[4] }}§T18:30¦{{ bc_d3 }}¦{{ bc_d3 }}¦18:30¦20:30¦{{ bc_d3 }}¦{{ bc_demo[5] }}§T09:00¦{{ bc_d4 }}¦{{ bc_d4 }}¦09:00¦11:00¦{{ bc_d4 }}¦{{ bc_demo[6] }}§T13:00¦{{ bc_d5 }}¦{{ bc_d5 }}¦13:00¦16:00¦{{ bc_d5 }}¦{{ bc_demo[7] }}§T19:00¦{{ bc_d6 }}¦{{ bc_d6 }}¦19:00¦20:30¦{{ bc_d6 }}¦{{ bc_demo[8] }}{% endcapture %}
{% endif %}
{% assign bc_rows = bc_rows | split: "§" | sort %}

{% comment %}
  One pass over the days from the 1st of this month to the end of the agenda: busy days of the month ("|9|") and
  the agenda as rows, "D¦date¦weekday¦day¦month¦days from today" per day, "E¦kind¦start¦end¦title" per event
  (kind A all day, P part x of y, R start–end, T at a time, F from, U until) and "N" for a free today.
{% endcomment %}
{% assign bc_month_key = bc_today_iso | slice: 0, 7 %}
{% assign bc_ms_ts = bc_month_key | append: "-01T12:00:00Z" | date: "%s" | plus: 0 %}
{% assign bc_back = bc_today_ts | minus: bc_ms_ts | divided_by: 86400 %}
{% assign bc_stop = bc_back | plus: bc_days_ahead | minus: 1 %}
{% if bc_stop < 30 %}{% assign bc_stop = 30 %}{% endif %}
{% assign bc_busy = "|" %}{% assign bc_mlen = 0 %}{% assign bc_list = "" %}{% assign bc_count = 0 %}
{% for bc_i in (0..bc_stop) %}
  {% assign bc_ts = bc_i | times: 86400 | plus: bc_ms_ts %}
  {% assign bc_d = bc_ts | date: "%Y-%m-%d" %}
  {% assign bc_in_month = false %}{% if bc_d contains bc_month_key %}{% assign bc_in_month = true %}{% assign bc_mlen = bc_i | plus: 1 %}{% endif %}
  {% assign bc_rel = bc_i | minus: bc_back %}
  {% assign bc_in_window = false %}{% if bc_rel >= 0 and bc_rel < bc_days_ahead %}{% assign bc_in_window = true %}{% endif %}
  {% unless bc_in_month or bc_in_window %}{% continue %}{% endunless %}
  {% assign bc_top = "" %}{% assign bc_timed = "" %}{% assign bc_hit = false %}
  {% for bc_r in bc_rows %}
    {% if bc_r.size < 5 %}{% continue %}{% endif %}
    {% assign bc_x = bc_r | split: "¦" %}
    {% if bc_x[1] > bc_d or bc_d > bc_x[2] %}{% continue %}{% endif %}
    {% assign bc_hit = true %}
    {% unless bc_in_window %}{% continue %}{% endunless %}
    {% if bc_x[0] == "A" %}
      {% if bc_x[2] > bc_x[1] %}
        {% assign bc_s_ts = bc_x[1] | append: "T12:00:00Z" | date: "%s" | plus: 0 %}
        {% assign bc_l_ts = bc_x[2] | append: "T12:00:00Z" | date: "%s" | plus: 0 %}
        {% assign bc_p = bc_ts | minus: bc_s_ts | divided_by: 86400 | plus: 1 %}
        {% assign bc_n = bc_l_ts | minus: bc_s_ts | divided_by: 86400 | plus: 1 %}
        {% capture bc_top %}{{ bc_top }}§E¦P¦{{ bc_p }}¦{{ bc_n }}¦{{ bc_x[6] }}{% endcapture %}
      {% else %}
        {% capture bc_top %}{{ bc_top }}§E¦A¦¦¦{{ bc_x[6] }}{% endcapture %}
      {% endif %}
    {% else %}
      {% comment %} Today: what has ended drops off. {% endcomment %}
      {% if bc_rel == 0 %}{% assign bc_end_str = bc_x[5] | append: "T" | append: bc_x[4] %}{% if bc_end_str <= bc_now_str %}{% continue %}{% endif %}{% endif %}
      {% if bc_x[1] == bc_d %}
        {% if bc_x[5] == bc_d and bc_x[3] == bc_x[4] %}{% capture bc_timed %}{{ bc_timed }}§E¦T¦{{ bc_x[3] }}¦¦{{ bc_x[6] }}{% endcapture %}
        {% elsif bc_x[5] == bc_d %}{% capture bc_timed %}{{ bc_timed }}§E¦R¦{{ bc_x[3] }}¦{{ bc_x[4] }}¦{{ bc_x[6] }}{% endcapture %}
        {% else %}{% capture bc_timed %}{{ bc_timed }}§E¦F¦{{ bc_x[3] }}¦¦{{ bc_x[6] }}{% endcapture %}{% endif %}
      {% elsif bc_x[5] == bc_d and bc_x[4] != "00:00" %}{% capture bc_top %}{{ bc_top }}§E¦U¦¦{{ bc_x[4] }}¦{{ bc_x[6] }}{% endcapture %}
      {% else %}{% capture bc_top %}{{ bc_top }}§E¦A¦¦¦{{ bc_x[6] }}{% endcapture %}{% endif %}
    {% endif %}
  {% endfor %}
  {% if bc_hit and bc_in_month %}{% assign bc_day_n = bc_ts | date: "%-d" %}{% assign bc_busy = bc_busy | append: bc_day_n | append: "|" %}{% endif %}
  {% if bc_in_window %}
    {% if bc_top != "" or bc_timed != "" or bc_rel == 0 %}
      {% assign bc_wdi = bc_ts | date: "%u" | minus: 1 %}{% assign bc_dm = bc_ts | date: "%-m" | minus: 1 %}{% assign bc_dd = bc_ts | date: "%-d" %}
      {% capture bc_list %}{{ bc_list }}§D¦{{ bc_d }}¦{{ bc_wdi }}¦{{ bc_dd }}¦{{ bc_dm }}¦{{ bc_rel }}{{ bc_top }}{{ bc_timed }}{% if bc_rel == 0 and bc_top == "" and bc_timed == "" %}§N{% endif %}{% endcapture %}
    {% endif %}
  {% endif %}
{% endfor %}
{% assign bc_list = bc_list | split: "§" %}

{% comment %} "14:30", or "2:30 PM" on a 12-hour clock. {% endcomment %}
{% template bc_time %}{% if h12 %}{% assign bc_hh = hm | slice: 0, 2 | plus: 0 %}{% assign bc_h = bc_hh | modulo: 12 %}{% if bc_h == 0 %}{% assign bc_h = 12 %}{% endif %}{{ bc_h }}:{{ hm | slice: 3, 2 }} {% if bc_hh < 12 %}AM{% else %}PM{% endif %}{% else %}{{ hm }}{% endif %}{% endtemplate %}

{% comment %} Title bar: a blossom, the title, and a hint when the events are only examples. {% endcomment %}
{% assign bc_name = bc_fields.calendar_name | strip %}
{% if bc_name == blank %}{% assign bc_name = bc_w_title %}{% endif %}
{% capture bc_title_bar %}
  <div class="title_bar">
    <svg class="w--6 h--6" viewBox="0 0 40 40" aria-hidden="true"><use href="#bc-daisy"/></svg>
    <span class="title">{{ bc_name | truncate: 40 }}</span>
    {% if bc_birthday %}<span class="instance">{{ bc_w_bday }}</span>{% elsif bc_has_source == false %}<span class="instance">{{ bc_w_demo }}</span>{% endif %}
  </div>
{% endcapture %}
{% assign bc_ok = true %}{% if bc_has_source and bc_has_data == false %}{% assign bc_ok = false %}{% endif %}

{% comment %}
  Drawings, defined once and used by reference. Outlines only, in the page's ink (currentColor), so they stay crisp
  on 1-bit screens and swap with dark mode; petals are spaced so their outlines never cross.
{% endcomment %}
<svg class="bc-defs" aria-hidden="true">
  <defs>
    <symbol id="bc-daisy" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2">
        {% for bc_a in (0..9) %}<ellipse cx="0" cy="-10" rx="2.6" ry="6.6" transform="rotate({{ bc_a | times: 36 }})"/>{% endfor %}
      </g>
      <circle r="4.2" fill="currentColor"/>
    </symbol>
    <symbol id="bc-sunflower" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
        {% for bc_a in (0..11) %}<path d="M-2.8 -7.6Q0 -20 2.8 -7.6Z" transform="rotate({{ bc_a | times: 30 }})"/>{% endfor %}
      </g>
      <circle r="6.6" fill="currentColor"/>
    </symbol>
    <symbol id="bc-cherries" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M-7 5Q-4 -8 3 -14M7 7Q6 -6 3 -14"/>
        <circle cx="-7.5" cy="10" r="5.6"/><circle cx="7.5" cy="12" r="5.6"/>
      </g>
      <path d="M3 -14Q10 -19 15 -13Q9 -9 3 -14Z" fill="currentColor"/>
    </symbol>
    <symbol id="bc-maple" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
        <path d="M0 -17L3.5 -9.5L10 -12.5L8.5 -4.5L16 -2.5L9.5 3L11 9L3.5 7L1 11.5L-1 11.5L-3.5 7L-11 9L-9.5 3L-16 -2.5L-8.5 -4.5L-10 -12.5L-3.5 -9.5Z"/>
        <path d="M0 11.5L0 18M0 8L0 -11M0 2L8 -3M0 2L-8 -3"/>
      </g>
    </symbol>
    <symbol id="bc-acorn" viewBox="-20 -20 40 40">
      <path d="M-10 -2Q-10 -12 0 -12Q10 -12 10 -2Z" fill="currentColor"/>
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M-7.5 -2Q-7.5 11 0 16Q7.5 11 7.5 -2"/><path d="M0 -12Q0 -16 3 -17"/>
      </g>
    </symbol>
    <symbol id="bc-snowflake" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        {% for bc_a in (0..5) %}<path d="M0 0V-16M0 -10L-4.5 -14M0 -10L4.5 -14M0 -5L-3 -8M0 -5L3 -8" transform="rotate({{ bc_a | times: 60 }})"/>{% endfor %}
      </g>
    </symbol>
    <symbol id="bc-holly" viewBox="-20 -20 40 40">
      <path d="M-1 0Q-6 -13 -17 -15Q-14 -5 -1 0Z" fill="currentColor"/>
      <path d="M1 0Q6 -13 17 -15Q14 -5 1 0Z" fill="currentColor"/>
      <g fill="currentColor">
        <circle cx="-5.5" cy="5" r="4.2"/><circle cx="5.5" cy="5" r="4.2"/><circle cx="0" cy="13.5" r="4.2"/>
      </g>
    </symbol>
    <symbol id="bc-star" viewBox="-20 -20 40 40">
      <path d="M0 -16L4.2 -4.8L16.2 -4.3L6.8 3.2L10 14.8L0 8.2L-10 14.8L-6.8 3.2L-16.2 -4.3L-4.2 -4.8Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <circle cy="1" r="2.6" fill="currentColor"/>
    </symbol>
    <symbol id="bc-candle" viewBox="-20 -20 40 40">
      <path d="M0 -18Q5.5 -11 0 -6.5Q-5.5 -11 0 -18Z" fill="currentColor"/>
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M0 -6.5V-3.5"/><rect x="-5" y="-3.5" width="10" height="19" rx="1.5"/><path d="M-11 16H11"/>
      </g>
    </symbol>
    <symbol id="bc-egg" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
        <path d="M0 -16C8 -16 12 -3 12 4C12 11 7 16 0 16C-7 16 -12 11 -12 4C-12 -3 -8 -16 0 -16Z"/>
        <path d="M-11.5 2L-7.5 -2L-3.5 2L0.5 -2L4.5 2L8.5 -2L11.5 1"/>
      </g>
      <circle cx="-5" cy="9" r="1.8" fill="currentColor"/><circle cx="1" cy="10" r="1.8" fill="currentColor"/><circle cx="6.5" cy="8" r="1.8" fill="currentColor"/>
    </symbol>
    <symbol id="bc-bunny" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2">
        <ellipse cx="-5" cy="-9" rx="3.6" ry="8.5" transform="rotate(-12 -5 -9)"/>
        <ellipse cx="5" cy="-9" rx="3.6" ry="8.5" transform="rotate(12 5 -9)"/>
        <circle cy="8" r="8.6"/>
      </g>
      <circle cx="-3.2" cy="6.5" r="1.4" fill="currentColor"/><circle cx="3.2" cy="6.5" r="1.4" fill="currentColor"/>
      <path d="M-1.6 10H1.6L0 11.8Z" fill="currentColor"/>
    </symbol>
    <symbol id="bc-heart-big" viewBox="-20 -20 40 40">
      <path d="M0 13C-10 5.5 -14.5 0.5 -14.5 -5.5A7 7 0 0 1 0 -9A7 7 0 0 1 14.5 -5.5C14.5 0.5 10 5.5 0 13Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M-7 -7A3.5 3.5 0 0 1 -2.5 -6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </symbol>
    <symbol id="bc-envelope" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
        <rect x="-15" y="-10" width="30" height="21" rx="2"/><path d="M-15 -9L0 2L15 -9"/>
      </g>
      <path d="M0 9C-4.5 5.5 -6.5 3.5 -6.5 1A3 3 0 0 1 0 -0.5A3 3 0 0 1 6.5 1C6.5 3.5 4.5 5.5 0 9Z" fill="currentColor"/>
    </symbol>
    <symbol id="bc-firework" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        {% for bc_a in (0..11) %}<path d="M0 -5V-13" transform="rotate({{ bc_a | times: 30 }})"/>{% endfor %}
      </g>
      <g fill="currentColor">{% for bc_a in (0..11) %}<circle cy="-16.5" r="1.7" transform="rotate({{ bc_a | times: 30 | plus: 15 }})"/>{% endfor %}<circle r="2.4"/></g>
    </symbol>
    <symbol id="bc-clover" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
        {% for bc_a in (0..3) %}<path d="M0 -1C-5 -4.5 -8.5 -7.5 -8.5 -11A4.2 4.2 0 0 1 0 -13A4.2 4.2 0 0 1 8.5 -11C8.5 -7.5 5 -4.5 0 -1Z" transform="rotate({{ bc_a | times: 90 | plus: 45 }})"/>{% endfor %}
        <path d="M1 1Q5 9 3 17"/>
      </g>
    </symbol>
    <symbol id="bc-pumpkin" viewBox="-20 -20 40 40">
      <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
        <path d="M0 -7C-6 -9.5 -16 -7.5 -16 3C-16 12.5 -8 15.5 0 14.5C8 15.5 16 12.5 16 3C16 -7.5 6 -9.5 0 -7Z"/>
        <path d="M-5.5 -7.6C-9.5 -1 -9.5 8 -5.5 14.6M5.5 -7.6C9.5 -1 9.5 8 5.5 14.6"/>
        <path d="M-1 -7.5L0 -14H3L2 -7.4"/>
